# ============================================================
# IoT Platform - 环境变量配置模板
# 使用说明: 复制此文件为 .env 并填入实际值
#           cp .env.example .env
# 注意: .env 文件已加入 .gitignore，请勿提交到版本控制
# ============================================================

# --- 应用基础配置 ---
APP_NAME=IoT-Platform
APP_ENV=development               # development | staging | production
APP_DEBUG=true                    # 开启调试模式 (生产环境设为 false)
SECRET_KEY=change-me-to-a-random-secret-string-at-least-32-chars

# --- MySQL 数据库配置 (本地 MySQL 8.0) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=iot_platform
DB_POOL_SIZE=10                   # 连接池大小
DB_POOL_RECYCLE=3600              # 连接回收时间（秒）
DB_ECHO=false                     # 是否打印 SQL 日志 (开发时可设为 true)

# --- Redis 配置 (本地 Redis) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=                   # 本地开发通常无密码，留空即可
REDIS_DB=0                        # Redis 数据库编号 (0-15)
REDIS_POOL_MAX_CONNECTIONS=20

# --- 服务端口 ---
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- CORS 允许的前端地址 ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
