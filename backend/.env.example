# ============================================================
# IoT Platform - 环境变量配置模板
# 使用说明: 复制此文件为 .env 并填入实际值
#           cp .env.example .env
# 注意: .env 文件已加入 .gitignore，请勿提交到版本控制
# ============================================================

# --- 应用基础配置 ---
APP_NAME=IoT-Platform
APP_ENV=development               # development | staging | production
APP_DEBUG=true                    # 开启调试模式 (生产环境设为 false)
SECRET_KEY=change-me-to-a-random-secret-string-at-least-32-chars

# --- MySQL 数据库配置 ---
# 本地开发
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=iot_platform
# 云数据库 (TiDB Cloud / Aiven 等)
# DB_HOST=gateway01.xxx.xxx.tidbcloud.com
# DB_PORT=4000
# DB_USER=root
# DB_PASSWORD=your_cloud_db_password
# DB_SSL=true                      # 云数据库必须开启
DB_POOL_SIZE=10
DB_POOL_RECYCLE=3600
DB_ECHO=false

# --- Redis 配置 ---
# 本地开发
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
# 云 Redis (Upstash / Redis Cloud 等)
# REDIS_HOST=xxx.upstash.io
# REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password
# REDIS_SSL=true                   # 云 Redis 通常需要 TLS
REDIS_DB=0
REDIS_POOL_MAX_CONNECTIONS=20

# --- 服务端口 ---
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- CORS 允许的前端地址 ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
